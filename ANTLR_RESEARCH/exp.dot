digraph G {
    rankdir = TB;
    overlap=false;
    splines = true;
    nodesep = 0.45;
    ranksep = 0.7;
    pad = 0.25;
    ordering = out;
    bgcolor="#F2F2F2";
    node [fontname = Helvetica; fontsize = 11; shape = box; style = filled;];
    edge [color = "#8A8A8A"; arrowhead=none, headport=n; penwidth = 1.2;];
    n1 [xlabel=STUFF;label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0-9</FONT><BR/><FONT COLOR="#DDDDDD">debug</FONT>>;fillcolor = "#8888FF";color = "#C9C9C9";];
    n2 [label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0-9</FONT><BR/><FONT COLOR="#323232">expr</FONT>>;fillcolor = "#F6F6F6";color = "#C9C9C9";fontcolor = "#323232";];
    n3 [label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0-9</FONT><BR/><FONT COLOR="#323232">num</FONT>>;fillcolor = "#F6F6F6";color = "#C9C9C9";fontcolor = "#323232";];
    n4 [label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0-9</FONT><BR/><FONT COLOR="#323232">sym</FONT>>;fillcolor = "#F6F6F6";color = "#C9C9C9";fontcolor = "#323232";];
    T1 [label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0</FONT><BR/><FONT COLOR="#323232">PLUS<BR/>+</FONT>>;fillcolor = "#FF6F60";color = "#C9C9C9";fontcolor = "#323232";];
    T2 [label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0</FONT><BR/><FONT COLOR="#323232">DIG<BR/>1</FONT>>;fillcolor = "#FF6F60";color = "#C9C9C9";fontcolor = "#323232";];
    T3 [label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0</FONT><BR/><FONT COLOR="#323232">DIG<BR/>2</FONT>>;fillcolor = "#FF6F60";color = "#C9C9C9";fontcolor = "#323232";];
    T4 [label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0</FONT><BR/><FONT COLOR="#323232">STREAM_SEP<BR/></FONT>>;fillcolor = "#FF6F60";color = "#C9C9C9";fontcolor = "#323232";];
    T5 [label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0</FONT><BR/><FONT COLOR="#323232">DIG<BR/>3</FONT>>;fillcolor = "#FF6F60";color = "#C9C9C9";fontcolor = "#323232";];
    T6 [label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0</FONT><BR/><FONT COLOR="#323232">DIG<BR/>4</FONT>>;fillcolor = "#FF6F60";color = "#C9C9C9";fontcolor = "#323232";];
    T7 [label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0</FONT><BR/><FONT COLOR="#323232">DIG<BR/>5</FONT>>;fillcolor = "#FF6F60";color = "#C9C9C9";fontcolor = "#323232";];
    T8 [label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0</FONT><BR/><FONT COLOR="#323232">DIG<BR/>5</FONT>>;fillcolor = "#FF6F60";color = "#C9C9C9";fontcolor = "#323232";];
    T9 [label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0</FONT><BR/><FONT COLOR="#323232">DIG<BR/>5</FONT>>;fillcolor = "#FF6F60";color = "#C9C9C9";fontcolor = "#323232";];
    T10 [label = <<FONT POINT-SIZE="9" COLOR="#4A92B5">* 0</FONT><BR/><FONT COLOR="#323232">DIG<BR/>5</FONT>>;fillcolor = "#FF6F60";color = "#C9C9C9";fontcolor = "#323232";];
    n1 -> n2 -> n3, T1, n4;
    n3 -> T2, T3, T4;
    n4 -> T5, T6, T7, T8, T9, T10;
}