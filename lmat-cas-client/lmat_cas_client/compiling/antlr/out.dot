digraph "Parse Tree" {
rankdir=TB;
splines=true;
nodesep=0.45;
ranksep=0.7;
pad=0.0;
ordering=out;
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style=filled, fillcolor="#FFFFFF", color="#C0C0C0", penwidth=1.75];
1 [label=atom];
2 [label=<Stub <font color="#808080"> (expr) </font>>];
5 [label=atom];
6 [label="latex_cmd_arg"];
7 [label=<ExponentialOp <font color="#808080"> (expr) </font>>];
10 [label=atom];
11 [label=<Stub <font color="#808080"> (expr) </font>>];
12 [label=<AdditiveOp <font color="#808080"> (expr) </font>>];
15 [label=atom];
16 [label=<Stub <font color="#808080"> (expr) </font>>];
18 [label=<Prefix <font color="#808080"> (expr) </font>>];
20 [label=<Prefix <font color="#808080"> (expr) </font>>];
21 [label=<AdditiveOp <font color="#808080"> (expr) </font>>];
23 [label=debug];
}
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style="filled,rounded", fillcolor="#A0AB88", color="#75775B", penwidth=1.75, fontcolor="#FAFBF9"];
0 [label="NUMBER\n10", xlabel=<<font color="#004D62">* 0</font>>];
3 [label="POW\n^", xlabel=<<font color="#004D62">* 1</font>>];
4 [label="NUMBER\n2", xlabel=<<font color="#004D62">* 2</font>>];
8 [label="MINUS\n-", xlabel=<<font color="#004D62">* 3</font>>];
9 [label="SYMBOL\nb", xlabel=<<font color="#004D62">* 4</font>>];
13 [label="PLUS\n+", xlabel=<<font color="#004D62">* 5</font>>];
14 [label="SYMBOL\na", xlabel=<<font color="#004D62">* 6</font>>];
17 [label="BANG\n!", xlabel=<<font color="#004D62">* 7</font>>];
19 [label="PERCENT\n\%", xlabel=<<font color="#004D62">* 8</font>>];
22 [label="ARG_WS\n<EOF>", xlabel=<<font color="#004D62">* 9</font>>];
}
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style="filled,rounded", fillcolor="#DD8F7D", color="#BC6A7A", penwidth=1.75, fontcolor="#FAFBF9"];
}
edge [arrowhead=none, headport=n, color="#808080", penwidth=1.75];
