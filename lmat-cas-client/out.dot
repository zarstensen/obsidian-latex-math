56 [label=<MultiplicativeOp <font color="#808080"> (a_expr) </font>>];
57 [label="singular_index"];
58 [label="index_entry"];
61 [label="primary_symbol"];
62 [label=symbol];
63 [label=<Stub <font color="#808080"> (a_expr) </font>>];
66 [label="primary_symbol"];
67 [label=symbol];
68 [label=<Stub <font color="#808080"> (a_expr) </font>>];
69 [label="range_index"];
