0 [label=<INT<br/><font fontname="monospace">\int</font>>, xlabel=<<font color="#004D62">* 0</font>>];
1 [label=<UNDERSCORE<br/><font fontname="monospace">_</font>>, xlabel=<<font color="#004D62">* 1</font>>];
2 [label=<NUMBER<br/><font fontname="monospace">5</font>>, xlabel=<<font color="#004D62">* 2</font>>];
5 [label=<POW<br/><font fontname="monospace">^</font>>, xlabel=<<font color="#004D62">* 3</font>>];
6 [label=<LBRACE<br/><font fontname="monospace">{</font>>, xlabel=<<font color="#004D62">* 4</font>>];
7 [label=<NUMBER<br/><font fontname="monospace">10</font>>, xlabel=<<font color="#004D62">* 5</font>>];
9 [label=<RBRACE<br/><font fontname="monospace">}</font>>, xlabel=<<font color="#004D62">* 6</font>>];
12 [label=<ID<br/><font fontname="monospace">x</font>>, xlabel=<<font color="#004D62">* 7</font>>];
16 [label=<POW<br/><font fontname="monospace">^</font>>, xlabel=<<font color="#004D62">* 8</font>>];
17 [label=<SQRT<br/><font fontname="monospace">\sqrt</font>>, xlabel=<<font color="#004D62">* 9</font>>];
18 [label=<NUMBER<br/><font fontname="monospace">2</font>>, xlabel=<<font color="#004D62">* 10</font>>];
24 [label=<DIFFERENTIAL<br/><font fontname="monospace">\dd</font>>, xlabel=<<font color="#004D62">* 11</font>>];
25 [label=<LPAREN<br/><font fontname="monospace">(</font>>, xlabel=<<font color="#004D62">* 12</font>>];
26 [label=<ID<br/><font fontname="monospace">x</font>>, xlabel=<<font color="#004D62">* 13</font>>];
30 [label=<PLUS<br/><font fontname="monospace">+</font>>, xlabel=<<font color="#004D62">* 14</font>>];
31 [label=<ID<br/><font fontname="monospace">y</font>>, xlabel=<<font color="#004D62">* 15</font>>];
36 [label=<MINUS<br/><font fontname="monospace">-</font>>, xlabel=<<font color="#004D62">* 16</font>>];
37 [label=<ID<br/><font fontname="monospace">y</font>>, xlabel=<<font color="#004D62">* 17</font>>];
42 [label=<RPAREN<br/><font fontname="monospace">)</font>>, xlabel=<<font color="#004D62">* 18</font>>];
46 [label=<ARG_WS<br/><font fontname="monospace">&lt;EOF&gt;</font>>, xlabel=<<font color="#004D62">* 19</font>>];
}
