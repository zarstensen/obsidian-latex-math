digraph "Parse Tree" {
rankdir=TB;
splines=true;
nodesep=0.45;
ranksep=0.7;
pad=0.0;
ordering=out;
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style=filled, fillcolor="#FFFFFF", color="#C0C0C0", penwidth=1.75];
1 [label="primary_symbol"];
2 [label=symbol];
3 [label="a_expr"];
5 [label="rel_op"];
7 [label="primary_symbol"];
8 [label=symbol];
9 [label="a_expr"];
10 [label=relation];
12 [label="a_lmat_expr"];
13 [label=debug];
}
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style="filled,rounded", fillcolor="#A0AB88", color="#75775B", penwidth=1.75, fontcolor="#FAFBF9"];
0 [label=<ID<br/><font fontname="monospace">a</font>>, xlabel=<<font color="#004D62">* 0</font>>];
4 [label=<LT<br/><font fontname="monospace">&lt;</font>>, xlabel=<<font color="#004D62">* 1</font>>];
6 [label=<ID<br/><font fontname="monospace">b</font>>, xlabel=<<font color="#004D62">* 2</font>>];
11 [label=<ARG_WS<br/><font fontname="monospace">&lt;EOF&gt;</font>>, xlabel=<<font color="#004D62">* 3</font>>];
}
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style="filled,rounded", fillcolor="#DD8F7D", color="#BC6A7A", penwidth=1.75, fontcolor="#FAFBF9"];
}
edge [arrowhead=none, headport=n, color="#808080", penwidth=1.75];
1 -> 0;
2 -> 1;
3 -> 2;
5 -> 4;
7 -> 6;
8 -> 7;
9 -> 8;
10 -> 3;
10 -> 5;
10 -> 9;
12 -> 10;
12 -> 11;
13 -> 12;
}
