digraph "Parse Tree" {
rankdir=TB;
splines=true;
nodesep=0.45;
ranksep=0.7;
pad=0.0;
ordering=out;
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style=filled, fillcolor="#FFFFFF", color="#C0C0C0", penwidth=1.75];
1 [label="primary_symbol"];
2 [label=symbol];
3 [label=<Stub <font color="#808080"> (a_expr) </font>>];
7 [label=<Stub <font color="#808080"> (a_expr) </font>>];
8 [label="index_entry"];
10 [label="index_entry"];
12 [label="index_arg"];
13 [label=<Index <font color="#808080"> (a_expr) </font>>];
15 [label="a_lmat_expr"];
16 [label=debug];
}
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style="filled,rounded", fillcolor="#A0AB88", color="#75775B", penwidth=1.75, fontcolor="#FAFBF9"];
0 [label=<ID<br/><font fontname="monospace">x</font>>, xlabel=<<font color="#004D62">* 0</font>>];
4 [label=<UNDERSCORE<br/><font fontname="monospace">_</font>>, xlabel=<<font color="#004D62">* 1</font>>];
5 [label=<LBRACE<br/><font fontname="monospace">{</font>>, xlabel=<<font color="#004D62">* 2</font>>];
6 [label=<NUMBER<br/><font fontname="monospace">5</font>>, xlabel=<<font color="#004D62">* 3</font>>];
9 [label=<COMMA<br/><font fontname="monospace">,</font>>, xlabel=<<font color="#004D62">* 4</font>>];
11 [label=<RBRACE<br/><font fontname="monospace">}</font>>, xlabel=<<font color="#004D62">* 5</font>>];
14 [label=<ARG_WS<br/><font fontname="monospace">&lt;EOF&gt;</font>>, xlabel=<<font color="#004D62">* 6</font>>];
}
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style="filled,rounded", fillcolor="#DD8F7D", color="#BC6A7A", penwidth=1.75, fontcolor="#FAFBF9"];
}
edge [arrowhead=none, headport=n, color="#808080", penwidth=1.75];
1 -> 0;
2 -> 1;
3 -> 2;
7 -> 6;
8 -> 7;
12 -> 5;
12 -> 8;
12 -> 9;
12 -> 10;
12 -> 11;
13 -> 3;
13 -> 4;
13 -> 12;
15 -> 13;
15 -> 14;
16 -> 15;
}
