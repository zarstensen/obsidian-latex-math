38 [label="primary_symbol"];
39 [label=symbol];
40 [label="atom_v2"];
41 [label="limit_expr"];
42 [label="atom_v2"];
43 [label="a_expr"];
44 [label="a_expr"];
46 [label="alg_statement"];
47 [label=debug];
}
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style="filled,rounded", fillcolor="#A0AB88", color="#75775B", penwidth=1.75, fontcolor="#FAFBF9"];
0 [label=<LIMIT<br/><font fontname="monospace">\lim</font>>, xlabel=<<font color="#004D62">* 0</font>>];
1 [label=<UNDERSCORE<br/><font fontname="monospace">_</font>>, xlabel=<<font color="#004D62">* 1</font>>];
2 [label=<LBRACE<br/><font fontname="monospace">{</font>>, xlabel=<<font color="#004D62">* 2</font>>];
3 [label=<ID<br/><font fontname="monospace">x</font>>, xlabel=<<font color="#004D62">* 3</font>>];
6 [label=<LIMIT_ARROW<br/><font fontname="monospace">\to</font>>, xlabel=<<font color="#004D62">* 4</font>>];
7 [label=<NUMBER<br/><font fontname="monospace">5</font>>, xlabel=<<font color="#004D62">* 5</font>>];
11 [label=<RBRACE<br/><font fontname="monospace">}</font>>, xlabel=<<font color="#004D62">* 6</font>>];
12 [label=<ID<br/><font fontname="monospace">x</font>>, xlabel=<<font color="#004D62">* 7</font>>];
15 [label=<POW<br/><font fontname="monospace">^</font>>, xlabel=<<font color="#004D62">* 8</font>>];
16 [label=<NUMBER<br/><font fontname="monospace">2</font>>, xlabel=<<font color="#004D62">* 9</font>>];
24 [label=<PLUS<br/><font fontname="monospace">+</font>>, xlabel=<<font color="#004D62">* 10</font>>];
25 [label=<LIMIT<br/><font fontname="monospace">\lim</font>>, xlabel=<<font color="#004D62">* 11</font>>];
26 [label=<UNDERSCORE<br/><font fontname="monospace">_</font>>, xlabel=<<font color="#004D62">* 12</font>>];
27 [label=<LBRACE<br/><font fontname="monospace">{</font>>, xlabel=<<font color="#004D62">* 13</font>>];
28 [label=<ID<br/><font fontname="monospace">y</font>>, xlabel=<<font color="#004D62">* 14</font>>];
31 [label=<LIMIT_ARROW<br/><font fontname="monospace">\to</font>>, xlabel=<<font color="#004D62">* 15</font>>];
32 [label=<NUMBER<br/><font fontname="monospace">5</font>>, xlabel=<<font color="#004D62">* 16</font>>];
36 [label=<RBRACE<br/><font fontname="monospace">}</font>>, xlabel=<<font color="#004D62">* 17</font>>];
37 [label=<ID<br/><font fontname="monospace">y</font>>, xlabel=<<font color="#004D62">* 18</font>>];
45 [label=<ARG_WS<br/><font fontname="monospace">&lt;EOF&gt;</font>>, xlabel=<<font color="#004D62">* 19</font>>];
}
