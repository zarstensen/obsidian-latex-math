digraph "Parse Tree" {
rankdir=TB;
splines=true;
nodesep=0.45;
ranksep=0.7;
pad=0.0;
ordering=out;
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style=filled, fillcolor="#FFFFFF", color="#C0C0C0", penwidth=1.75];
4 [label="primary_symbol"];
5 [label=symbol];
8 [label="atom_v2"];
9 [label="a_expr"];
10 [label="limit_dir"];
13 [label="primary_symbol"];
14 [label=atom];
17 [label=atom];
18 [label="pow_arg"];
19 [label="postfix_op"];
