digraph "Parse Tree" {
rankdir=TB;
splines=true;
nodesep=0.45;
ranksep=0.7;
pad=0.0;
ordering=out;
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style=filled, fillcolor="#FFFFFF", color="#C0C0C0", penwidth=1.75];
1 [label="primary_symbol"];
2 [label=symbol];
3 [label="a_expr"];
5 [label="rel_op"];
7 [label="a_expr"];
8 [label=relation];
9 [label="system_el"];
12 [label="primary_symbol"];
13 [label=symbol];
14 [label="a_expr"];
16 [label="rel_op"];
18 [label="a_expr"];
19 [label=relation];
20 [label="system_el"];
21 [label="system_and_chain"];
22 [label=system];
24 [label="a_lmat_expr"];
25 [label=debug];
}
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style="filled,rounded", fillcolor="#A0AB88", color="#75775B", penwidth=1.75, fontcolor="#FAFBF9"];
0 [label=<ID<br/><font fontname="monospace">x</font>>, xlabel=<<font color="#004D62">* 0</font>>];
4 [label=<EQ<br/><font fontname="monospace">=</font>>, xlabel=<<font color="#004D62">* 1</font>>];
6 [label=<NUMBER<br/><font fontname="monospace">5</font>>, xlabel=<<font color="#004D62">* 2</font>>];
10 [label=<AND<br/><font fontname="monospace">\land</font>>, xlabel=<<font color="#004D62">* 3</font>>];
11 [label=<ID<br/><font fontname="monospace">y</font>>, xlabel=<<font color="#004D62">* 4</font>>];
15 [label=<EQ<br/><font fontname="monospace">=</font>>, xlabel=<<font color="#004D62">* 5</font>>];
17 [label=<NUMBER<br/><font fontname="monospace">10</font>>, xlabel=<<font color="#004D62">* 6</font>>];
23 [label=<ARG_WS<br/><font fontname="monospace">&lt;EOF&gt;</font>>, xlabel=<<font color="#004D62">* 7</font>>];
}
subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style="filled,rounded", fillcolor="#DD8F7D", color="#BC6A7A", penwidth=1.75, fontcolor="#FAFBF9"];
}
edge [arrowhead=none, headport=n, color="#808080", penwidth=1.75];
