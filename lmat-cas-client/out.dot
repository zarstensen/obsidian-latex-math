8 [label=<ID<br/><font fontname="monospace">x</font>>, xlabel=<<font color="#004D62">* 4</font>>];
13 [label=<RPAREN<br/><font fontname="monospace">)</font>>, xlabel=<<font color="#004D62">* 5</font>>];
15 [label=<BANG<br/><font fontname="monospace">!</font>>, xlabel=<<font color="#004D62">* 6</font>>];
