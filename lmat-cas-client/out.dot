subgraph {
node [shape=box, margin="0,0.05", height=0, width=1.75, style="filled,rounded", fillcolor="#A0AB88", color="#75775B", penwidth=1.75, fontcolor="#FAFBF9"];
0 [label=<ID<br/><font fontname="monospace">M</font>>, xlabel=<<font color="#004D62">* 0</font>>];
4 [label=<POW<br/><font fontname="monospace">^</font>>, xlabel=<<font color="#004D62">* 1</font>>];
5 [label=<NUMBER<br/><font fontname="monospace">2</font>>, xlabel=<<font color="#004D62">* 2</font>>];
8 [label=<UNDERSCORE<br/><font fontname="monospace">_</font>>, xlabel=<<font color="#004D62">* 3</font>>];
