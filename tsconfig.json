{
  "compilerOptions": {
    "paths": {
      "/*": [
        "./src/*"
      ]
    },
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "esnext",
    "target": "ES2022",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "resolvePackageJsonExports": false,
    "skipLibCheck": true,
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7",
      "ES2022"
    ],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "**/*.ts"
  ]
}